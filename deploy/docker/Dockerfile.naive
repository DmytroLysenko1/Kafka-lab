# The Dockerfile a Go service usually starts with, kept only as the "before" of
# docs/k8s/01-docker.md: the toolchain, the sources and the module cache all ship to
# production, the process runs as root, and any edit to any file rebuilds from scratch.
# make image-measure builds it next to deploy/docker/Dockerfile. Never deployed.
# Pinned by digest like the real one: it is half of the same measurement.

FROM golang:1.26.4@sha256:f96cc555eb8db430159a3aa6797cd5bae561945b7b0fe7d0e284c63a3b291609
WORKDIR /src
COPY . .
ARG SERVICE
RUN go build -o /service ./cmd/${SERVICE}
ENTRYPOINT ["/service"]
